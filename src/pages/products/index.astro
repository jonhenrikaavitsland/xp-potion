---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';

const allProducts = Object.values(
  import.meta.glob('./*.md', { eager: true })
).sort((a: any, b: any) => a.frontmatter.id - b.frontmatter.id);

const description =
  'Explore all XP Potion products — from energy drinks to hydration blends. Level up your energy, focus, and endurance with gamer-designed formulas.';
---

<BaseLayout title='Products' description={description}>
  <div class='lg:container lg:mx-auto py-12 px-5'>
    <section class='flex flex-col gap-18'>
      <div class='flex flex-col gap-6'>
        <h1 class='font-bold text-4xl'>Our Products</h1>
        <p class='max-w-xl'>
          XP Potion is the authentic gamer energy drink built for
          performance and hydration without the crash. Choose your
          potion—Original Boost, Zero Sugar, or the limited Mystery
          Boost—and power through long gaming sessions, streams, and
          esports battles with clean, focused energy.
        </p>
      </div>
      <ul
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
      >
        {
          allProducts.map((product: any) => (
            <ProductCard
              url={product.url}
              heading={product.frontmatter.heading}
              excerpt={product.frontmatter.excerpt}
              image={product.frontmatter.image}
            />
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
