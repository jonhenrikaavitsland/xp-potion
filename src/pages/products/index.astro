---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';

const allProducts = Object.values(
  import.meta.glob('./*.md', { eager: true })
);
---

<BaseLayout>
  <div class='lg:container lg:mx-auto py-12 px-5'>
    <section class='flex flex-col gap-18'>
      <div class='flex flex-col gap-6'>
        <h1 class='font-bold text-4xl'>Our Products</h1>
        <p class='max-w-xl'>
          Lorem ipsum dolor sit amet consectetur adipisicing elit.
          Corporis distinctio neque labore necessitatibus eveniet
          accusamus iste laudantium aspernatur natus est esse
          dignissimos, magni mollitia, iure consequatur iusto
          cupiditate a facilis.
        </p>
      </div>
      <ul
        class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'
      >
        {
          allProducts.map((product: any) => (
            <ProductCard
              url={product.url}
              heading={product.frontmatter.heading}
              excerpt={product.frontmatter.excerpt}
              image={product.frontmatter.image}
            />
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
