---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Read XP Potion’s Cookie Policy to understand how we use cookies to improve your browsing experience, personalize content, and ensure site functionality.';
---

<BaseLayout title='Cookie Policy' description={description}>
  <div class='lg:container lg:mx-auto pt-2 pb-12 px-5'>
    <Breadcrumbs />
    <section class='pt-10'>
      <!-- Start CookieYes cookie policy -->
      <script
        id='cky-cookie-policy'
        type='text/javascript'
        src='https://cdn-cookieyes.com/client_data/c372e1aa92ac56d7461bc576/cookie-policy/script.js'
        is:inline></script>
      <!-- End CookieYes cookie policy -->
    </section>
  </div>
</BaseLayout>
