---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MysteryBoostGuess from '../components/MysteryBoostGuess';
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'Join the XP Potion Mystery Boost challenge. Guess the secret flavor, unlock clues, and compete for prizes in this limited-edition gamer quest.';
---

<BaseLayout
  title='Guess the Mystery Boost'
  description={description}
>
  <div class='lg:container lg:mx-auto pt-2 pb-12 px-5'>
    <Breadcrumbs />
    <div class='pt-10'>
      <section
        class='flex flex-col gap-8 text-center md:text-start'
      >
        <div class='flex flex-col text-center gap-2'>
          <h1 class='capitalize text-4xl font-bold font-serif'>
            can you guess the flavour?
          </h1>
          <p>Grab a can, taste the unknown, and join the hunt.</p>
          <img
            src='/assets/images/xp-potion-mystery-boost-limited-edition-gamer-energy-drink.png'
            alt=''
            class='w-full max-w-xl mx-auto'
          />
        </div>
        <MysteryBoostGuess client:load />
      </section>
    </div>
  </div>
</BaseLayout>
