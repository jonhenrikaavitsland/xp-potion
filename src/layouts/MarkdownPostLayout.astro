---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShareX from '../components/SocialShareX.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
>
  <div class='lg:container lg:mx-auto px-5 pt-2 pb-12'>
    <Breadcrumbs />
    <div class='pt-10'>
      <div class='flex flex-col gap-4 max-w-2xl mx-auto'>
        <div class='order-2 flex flex-col gap-2'>
          <p>{frontmatter.pubDate.toString().slice(0, 10)}</p>
          <p class='italic'>{frontmatter.description}</p>
          <p>Written by: {frontmatter.author}</p>
          <div>
            <SocialShareX
              url={`https://xp-potion.netlify.app${frontmatter.url}`}
              text={frontmatter.heading}
            />
          </div>
        </div>
        <img
          src={frontmatter.image.url}
          alt={frontmatter.image.alt}
          loading='lazy'
        />
      </div>
      <article
        class='prose prose-lg mx-auto max-w-2xl mt-6 pt-2 border-t prose-invert'
      >
        <slot />
      </article>
      <div
        class='flex gap-12 items-center max-w-2xl mx-auto pt-6 pb-12 border-t border-accent-magenta-purple/60 mt-12'
      >
        <SocialShareX
          url={`https://xp-potion.netlify.app${frontmatter.url}`}
          text={frontmatter.heading}
        />
        <a
          href='#'
          class='text-accent-neon-pink hover:text-accent-magenta-purple'
          >Back to top</a
        >
      </div>
    </div>
  </div>
</BaseLayout>
