---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShareX from '../components/SocialShareX.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
>
  <div class='lg:container lg:mx-auto px-5 pt-2 pb-12'>
    <Breadcrumbs />
    <div class='pt-10'>
      <p>{frontmatter.pubDate.toString().slice(0, 10)}</p>
      <p class='italic'>{frontmatter.description}</p>
      <p>Written by {frontmatter.author}</p>
      <SocialShareX
        url={`https://xp-potion.netlify.app${frontmatter.url}`}
        text={frontmatter.heading}
      />
      <img
        src={frontmatter.image.url}
        width='300'
        alt={frontmatter.image.alt}
      />
      <article
        class='prose prose-lg mx-auto mt-6 pt-2 border-t prose-invert'
      >
        <slot />
      </article>
      <div class='flex gap-12 items-center'>
        <SocialShareX
          url={`https://xp-potion.netlify.app${frontmatter.url}`}
          text={frontmatter.heading}
        />
        <a
          href='#'
          class='text-accent-neon-pink hover:text-accent-magenta-purple'
          >Back to top</a
        >
      </div>
    </div>
  </div>
</BaseLayout>
