---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SocialShareX from '../components/SocialShareX.astro';
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
>
  <div class='lg:container lg:mx-auto px-5 pt-2 pb-12'>
    <Breadcrumbs
      labelMap={{
        'xp-potion-x-rascals': 'XP Potion x Rascals',
        'xp-potion-has-landed': 'XP Potion Has Landed',
      }}
    />
    <div class='pt-10'>
      <div class='flex flex-col md:flex-row gap-6'>
        <div class='grow'>
          <img
            src={frontmatter.image.url}
            alt={frontmatter.image.alt}
          />
        </div>
        <section class='flex flex-col gap-4 grow'>
          <h1 class='font-bold text-2xl'>{frontmatter.heading}</h1>
          <p>{frontmatter.description}</p>
        </section>
      </div>
      <article
        class='prose prose-lg mx-auto mt-6 pt-2 border-t prose-invert'
      >
        <slot />
      </article>
      <div class='flex gap-12 items-center'>
        <SocialShareX
          url={`https://xp-potion.netlify.app${frontmatter.url}`}
          text={frontmatter.heading}
        />
        <a
          href='#'
          class='text-accent-neon-pink hover:text-accent-magenta-purple'
          >Back to top</a
        >
      </div>
    </div>
  </div>
</BaseLayout>
