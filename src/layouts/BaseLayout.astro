---
const { title, description } = Astro.props;
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<html lang='en'>
  <head>
    <!-- Start cookieyes banner -->
    <script
      type='text/javascript'
      nonce='32f8659ac0544643bd7014df115'
      src='//local.adguard.org?ts=1757853788821&type=content-script&dmn=app.cookieyes.com&url=https%3A%2F%2Fapp.cookieyes.com%2Fapi%2Fv2%2Fwebsites%2F1155649%2Fscript&app=msedge.exe&css=3&js=1&rel=1&rji=1&sbe=1'
    ></script>
    <script
      type='text/javascript'
      nonce='32f8659ac0544643bd7014df115'
      src='//local.adguard.org?ts=1757853788821&name=AdGuard%20Extra&name=AdGuard%20Popup%20Blocker&type=user-script'
    ></script>
    <script
      id='cookieyes'
      type='text/javascript'
      src='https://cdn-cookieyes.com/client_data/c372e1aa92ac56d7461bc576/script.js'
    ></script>
    <!-- End cookieyes banner -->

    <meta charset='utf-8' />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/assets/images/favicon.png'
    />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <meta name='description' content={description} />
    <title>{title} | XP Potion</title>
    <meta name='robots' content='noindex, nofollow' />
  </head>
  <body
    class='flex flex-col min-h-screen bg-neutral-charcoal-black scroll-smooth'
  >
    <Header />
    <main class='grow text-white'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
