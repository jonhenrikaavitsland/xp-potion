---
let allNews = Object.values(
  import.meta.glob('../pages/news/*.md', { eager: true })
);

// Sort by date (newest first)
allNews = allNews.sort((a: any, b: any) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});
---

<div
  class='bg-[url(/src/assets/images/energetic-background-image.jpg)] bg-no-repeat bg-cover bg-neutral-charcoal-black/95 bg-blend-multiply py-24 px-5'
>
  <div
    class='grid grid-cols-4 lg:grid-cols-3 gap-12 lg:container lg:mx-auto'
  >
    <section
      class='flex flex-col gap-8 col-span-full lg:col-span-2'
    >
      <h1 class='font-bold font-serif text-4xl'>
        Power Up Your Game with XP Potion
      </h1>
      <p>
        Level up your energy, focus, and endurance with the original
        gaming potion. From clean daily boosts to limited-edition
        drops, XP Potion is crafted to fuel gamers, streamers, and
        creators without the crash.
      </p>
      <a
        href='/products'
        class='capitalize py-4 px-8 bg-accent-neon-pink/90 hover:bg-primary-sunset-orange hover:text-black rounded-lg block max-w-min whitespace-nowrap font-bold'
        >view all products</a
      >
    </section>
    <section
      class='flex flex-col gap-12 bg-neutral-800/80 p-5 rounded-xl col-span-full md:col-start-2 md:col-end-4 lg:col-auto'
    >
      <h2
        class='capitalize font-serif text-2xl font-semibold pb-4 border-b border-accent-magenta-purple/60'
      >
        latest news
      </h2>
      <ul class='flex flex-col gap-4'>
        {
          allNews.map((news: any, i) => (
            <li>
              <a href={news.url} target='_self'>
                <section
                  class={`flex flex-col gap-1 rounded-xl p-4 border-s-2 transition-colors duration-300 ease-in-out hover:border-accent-neon-pink ${i === 0 ? 'bg-accent-magenta-purple/20 border-accent-magenta-purple' : 'bg-accent-magenta-purple/10 border-accent-magenta-purple/80'}`}
                >
                  <h3 class='text-xl font-semibold font-serif'>
                    {news.frontmatter.heading}
                  </h3>
                  <p>{news.frontmatter.excerpt}</p>
                </section>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</div>
