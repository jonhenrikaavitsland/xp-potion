---
const allNews = [
  {
    title: 'Some news title',
    excerpt:
      'Lorem ipsum dolor, sit amet consectetur adipisicing elit.',
  },
  {
    title: 'Some news title',
    excerpt:
      'Lorem ipsum dolor, sit amet consectetur adipisicing elit. At ea obcaecati soluta',
  },
  {
