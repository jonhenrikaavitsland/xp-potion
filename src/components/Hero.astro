---
let allNews = Object.values(
  import.meta.glob('../pages/news/*.mdx', { eager: true })
);

// Sort by date (newest first)
allNews = allNews.sort((a: any, b: any) => {
  return (
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
  );
});
---

<div
  class='bg-[url(/src/assets/images/energetic-background-image.jpg)] bg-no-repeat bg-cover bg-neutral-charcoal-black/95 bg-blend-multiply py-24 px-5'
>
  <div class='lg:container lg:mx-auto'>
    <section
      class='flex flex-col gap-12 bg-neutral-800/70 p-5 md:p-7 lg:p-10 rounded-xl lg:mx-auto'
    >
      <h2
        class='capitalize font-serif text-4xl font-semibold pb-4 border-b border-accent-magenta-purple/60'
      >
        latest news
      </h2>
      <ul class='grid grid-cols-3 gap-8'>
        {
          allNews.map((news: any, i) => (
            <li class='col-span-full md:col-span-1'>
              <a href={news.url} target='_self'>
                <div
                  class={`flex flex-col rounded-xl border-s-4 transition-colors duration-300 ease-in-out hover:border-accent-neon-pink h-full bg-accent-magenta-purple/10 ${i === 0 ? 'border-accent-magenta-purple' : 'border-accent-magenta-purple/60'}`}
                >
                  <div class='aspect-video rounded-s-xl shrink-0 overflow-hidden'>
                    <img
                      src={news.frontmatter.image.url}
                      alt={news.frontmatter.image.alt}
                      class='h-full w-full aspect-video object-cover rounded-s-xl'
                    />
                  </div>
                  <section
                    class={`flex flex-col gap-1 rounded-xl pt-4 px-4 pb-8`}
                  >
                    <h3 class='text-xl font-semibold font-serif'>
                      {news.frontmatter.heading}
                    </h3>
                    <p>{news.frontmatter.excerpt}</p>
                  </section>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</div>
