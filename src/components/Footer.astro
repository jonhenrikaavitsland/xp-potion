---
import { Image } from 'astro:assets';
import logo from '../assets/images/xp-potion-logo.png';

const quickLinks = [
  { path: '/', label: 'Home' },
  { path: '/products', label: 'Products' },
  { path: '/blog', label: 'Blog' },
  { path: '/about', label: 'About Us' },
  { path: '/contact', label: 'Contact' },
];

const supportLinks = [
  { path: '/faq', label: 'FAQ' },
  { path: '/news', label: 'News' },
  { path: '/cookie-policy', label: 'Cookie Policy' },
  { path: '/privacy-policy', label: 'Privacy Policy' },
  { path: '/terms-of-service', label: 'Terms of Service' },
];

const socialIcons = [
  {
    image: '/assets/icons/discord-brand.svg',
    label: 'XP Potion official Discord server icon',
    link: 'https://discord.com/',
  },
  {
    image: '/assets/icons/tiktok-brand.svg',
    label: 'XP Potion official TikTok icon',
    link: 'https://www.tiktok.com/',
  },
  {
    image: '/assets/icons/twitch-brand.svg',
    label: 'XP Potion official Twitch channel icon',
    link: 'https://www.twitch.tv/',
  },
  {
    image: '/assets/icons/x-twitter-brand.svg',
    label: 'XP Potion official X (Twitter) icon',
    link: 'https://x.com/',
  },
];
---

<footer class='bg-accent-magenta-purple text-white py-12 px-6'>
  <div
    class='flex flex-col md:flex-row gap-8 lg:container lg:mx-auto pb-8'
  >
    <section class='flex flex-col gap-4 grow'>
      <div class='flex gap-3 items-center'>
        <div class='w-15 h-15'>
          <Image
            src={logo}
            alt='XP Potion'
            widths={[100, 200]}
            format='png'
            loading='lazy'
          />
        </div>
        <h2 class='capitalize font-bold text-2xl'>
          <span class='uppercase'>xp</span> potion
        </h2>
      </div>

      <p class='italic max-w-md'>
        Boost your game, boost your XP. The ultimate energy drink
        designed specifically for gamers who demand peak
        performance.
      </p>
      <div class='flex gap-6'>
        {
          socialIcons.map((icon) => (
            <a href={icon.link} target='_blank'>
              <img
                src={icon.image}
                alt={icon.label}
                class='h-6 max-w-full icon-white'
                loading='lazy'
              />
              <span class='sr-only'>{icon.label}</span>
            </a>
          ))
        }
      </div>
    </section>
    <div class='flex flex-col md:flex-row gap-8 grow'>
      <section class='flex flex-col gap-4 md:grow'>
        <h2 class='capitalize font-semibold'>quick links</h2>
        <ul class='space-y-2'>
          {
            quickLinks.map((qLink) => (
              <li>
                <a
                  href={qLink.path}
                  target='_self'
                  class='hover:font-semibold block w-50 py-1 md:py-0'
                >
                  {qLink.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class='flex flex-col gap-4 md:grow'>
        <h2 class='capitalize font-semibold'>support</h2>
        <ul class='space-y-2'>
          {
            supportLinks.map((sLink) => (
              <li>
                <a
                  href={sLink.path}
                  target='_self'
                  class='hover:font-semibold block w-50 py-1 md:py-0'
                >
                  {sLink.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
  <div class='border-t border-accent-deep-violet/30'>
    <p class='italic text-center pt-8'>
      © 2025 XP Potion. All rights reserved. Boost your game, boost
      your XP.
    </p>
  </div>
</footer>
