---
const { url, excerpt, image, heading } = Astro.props;
---

<li>
  <section class='rounded-xl shadow-md h-full'>
    <a href={url}>
      <div
        class='bg-neutral-800 flex flex-col gap-2 pb-3 rounded-xl h-full border-neutral-charcoal-black border-t-2 duration-300 ease-in-out hover:border-accent-neon-pink'
      >
        <div class='rounded-t-xl aspect-square'>
          <img
            src={image.url}
            alt={image.alt}
            class='rounded-t-xl h-full w-full aspect-square object-contain'
          />
        </div>
        <div class='flex flex-col gap-2 p-3'>
          <h2 class='font-bold'>{heading}</h2>
          <p>{excerpt}</p>
        </div>
      </div>
    </a>
  </section>
</li>
