---
const { url, excerpt, image, heading } = Astro.props;
---

<li>
  <section class='rounded-xl shadow-md'>
    <a href={url}>
      <div class='border flex flex-col gap-2 pb-3 rounded-xl'>
        <div class='rounded-t-xl'>
          <img
            src={image.url}
            alt={image.alt}
            class='rounded-t-xl'
          />
        </div>
        <div class='flex flex-col gap-2 p-3'>
          <h2 class='font-bold'>{heading}</h2>
          <p>{excerpt}</p>
        </div>
      </div>
    </a>
  </section>
</li>
