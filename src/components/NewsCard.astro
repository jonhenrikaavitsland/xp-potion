---
const { heading, date, url } = Astro.props;

// Format the date for display
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<li>
  <a href={url}>
    <div class='flex gap-6 bg-neutral-800 p-4 rounded-xl'>
      <time datetime={date} class='w-38'>{formattedDate}</time>
      <p>{heading}</p>
    </div>
  </a>
</li>
