---
import { Image } from 'astro:assets';
import logo from '../assets/images/xp-potion-logo.png';
import BannerTop from '../components/BannerTop';

const navLinks = [
  { link: '/', label: 'home' },
  { link: '/products', label: 'products' },
  { link: '/blog', label: 'blog' },
  { link: '/about', label: 'about' },
  { link: '/contact', label: 'contact' },
];
---

<header
  class='flex flex-col sticky top-0 z-50 bg-accent-magenta-purple shadow-md transition-all duration-300 will-change-transform'
  id='site-header'
>
  <BannerTop
    client:load
    id='mystery-boost-announce'
    text='Mystery Boost is live — guess the flavor & win!'
    href='/products/mystery-boost'
    bgClass='bg-neutral-charcoal-black text-white'
    heightClass=''
    position='absolute'
    pushDown={true}
  />
  <div
    class='flex justify-between flex-wrap md:flex-nowrap md:justify-normal px-5 lg:container lg:mx-auto'
  >
    <div
      class='w-20 h-20 md:w-28 md:h-28 flex justify-center items-center mx-auto md:mx-0'
    >
      <a href='/'>
        <Image
          src={logo}
          alt='XP Potion'
          widths={[100, 200, 300, 400]}
          format='png'
        />
      </a>
      <span class='sr-only text-white'>Home</span>
    </div>

    <nav
      class='hidden md:flex justify-end items-center w-full'
      aria-label='primary navigation'
    >
      <ul
        class='flex gap-6 uppercase whitespace-nowrap font-bold text-xl font-sans text-white'
      >
        {
          navLinks?.map((navLink) => (
            <li>
              <a
                href={navLink.link}
                class='block py-2.5 leading-none hover:underline hover:underline-offset-4'
              >
                {navLink.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile menu toggle -->
    <details
      class='z-10 flex my-auto md:hidden'
      aria-label='Toggle navigation'
    >
      <summary class='flex justify-end cursor-pointer p-1.25'>
        <img
          src='/assets/icons/bars.svg'
          alt='Open menu'
          class='open-icon h-8 w-8 icon-white'
          aria-hidden='true'
        />
        <img
          src='/assets/icons/close.svg'
          alt='Close menu'
          class='close-icon hidden h-8 w-8 icon-white'
          aria-hidden='true'
        />
      </summary>

      <div
        class='absolute left-0 right-0 top-full bg-white border-t p-5 z-50 shadow-md'
      >
        <ul
          class='flex flex-col gap-4 font-medium capitalize text-xl'
        >
          {
            navLinks?.map((navLink) => (
              <li>
                <a
                  href={navLink.link}
                  class='block px-2 py-2.5 leading-none hover:underline hover:underline-offset-4'
                >
                  {navLink.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </div>
</header>
<style>
  /* Smoothly slide the header out and disable interactions */
  .header--hidden {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  details[open] .open-icon {
    display: none;
  }

  details[open] .close-icon {
    display: inline;
  }

  details[open] > div {
    animation: slideDown 0.2s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    if (!header) return;

    const HIDE_AFTER_MS = 1000; // 1s delay
    const THRESHOLD = 200; // 200px scroll
    let timer = null;
    let hidden = false;

    const hasOpenMenus = () =>
      !!document.querySelector('details[open]');

    const scheduleHide = () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        if (window.scrollY > THRESHOLD && !hasOpenMenus()) {
          header.classList.add('header--hidden');
          hidden = true;
        }
      }, HIDE_AFTER_MS);
    };

    const showNow = () => {
      clearTimeout(timer);
      if (hidden) {
        header.classList.remove('header--hidden');
        hidden = false;
      }
    };

    // Show when user is near the top; schedule hide when beyond threshold
    const onScroll = () => {
      if (window.scrollY <= THRESHOLD) {
        showNow();
      } else {
        scheduleHide();
      }
    };

    // If a mobile <details> menu opens, keep header visible
    document.addEventListener(
      'toggle',
      (e) => {
        const t = e.target;
        if (t instanceof HTMLDetailsElement) {
          if (t.open) showNow();
          else onScroll();
        }
      },
      true
    );

    // Also reveal header on pointer move near the top edge
    window.addEventListener('mousemove', (e) => {
      if (e.clientY < 80) showNow();
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
