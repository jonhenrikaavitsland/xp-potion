---
const { title, url, image, excerpt, heading } = Astro.props;
---

<li>
  <section class='rounded-xl shadow-md'>
    <a href={url}>
      <div
        class='bg-neutral-800 flex flex-col gap-2 pb-3 rounded-xl'
      >
        <div class='rounded-t-xl aspect-square'>
          <img
            src={image.url}
            alt={image.alt}
            class='rounded-t-xl h-full w-full object-contain'
          />
        </div>
        <div class='flex flex-col gap-2 p-3'>
          <h2 class='font-bold'>{heading}</h2>
          <p>{excerpt}</p>
        </div>
      </div>
    </a>
  </section>
</li>
